# ══════════════════════════════════════════════════════════════════════════════
# AUTO-DOC ENGINE — Environment Configuration
# ══════════════════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values.
# All values can also be set as real environment variables (env takes priority).

# ── AI Provider ───────────────────────────────────────────────────────────────
# Which provider to use by default.
# Options: gemini | huggingface | ollama | auto
# 'auto' cascades: Gemini → HuggingFace → Ollama
AUTODOC_PROVIDER=auto

# ── Google Gemini ─────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-pro

# ── Hugging Face ──────────────────────────────────────────────────────────────
HF_API_KEY=your_huggingface_api_key_here
# Serverless inference model (free tier):
HF_MODEL=mistralai/Mistral-7B-Instruct-v0.3
# Optional: override with a dedicated inference endpoint URL
# HF_ENDPOINT=https://your-endpoint.huggingface.cloud/v1/chat/completions

# ── Ollama (Local) ────────────────────────────────────────────────────────────
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3

# ── Output ────────────────────────────────────────────────────────────────────
AUTODOC_OUTPUT_DIR=./reports

# ── Sanitization ──────────────────────────────────────────────────────────────
# Set to 'false' to disable IP/hash redaction (NOT recommended for public sharing)
AUTODOC_SANITIZE=true
